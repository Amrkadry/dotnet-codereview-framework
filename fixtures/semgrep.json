{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [{
    "tool": { "driver": { "name": "semgrep", "semanticVersion": "1.90.0", "rules": [
      { "id": "moraa-dotnet-disable-cert-validation",
        "shortDescription": { "text": "TLS certificate validation disabled process-wide" },
        "help": { "text": "Scope any override to a single HttpClientHandler." },
        "defaultConfiguration": { "level": "error" },
        "properties": { "tags": ["security", "CWE-295: Improper Certificate Validation"], "precision": "very-high" } },
      { "id": "moraa-dotnet-regex-no-timeout",
        "shortDescription": { "text": "Regex used without a match timeout" },
        "help": { "text": "Pass a TimeSpan or set a process-wide default." },
        "defaultConfiguration": { "level": "warning" },
        "properties": { "tags": ["security", "CWE-1333"], "precision": "high" } }
    ] } },
    "results": [
      { "ruleId": "moraa-dotnet-disable-cert-validation", "level": "error",
        "message": { "text": "TLS certificate validation is disabled process-wide." },
        "locations": [{ "physicalLocation": {
          "artifactLocation": { "uri": "SampleApp/Services/Http.cs" },
          "region": { "startLine": 42, "endLine": 43, "snippet": { "text": "ServicePointManager.ServerCertificateValidationCallback = delegate { return true; };" } } } }],
        "partialFingerprints": { "semgrepHash": "abc123" } },
      { "ruleId": "moraa-dotnet-regex-no-timeout", "level": "warning",
        "message": { "text": "Regex used without a match timeout." },
        "locations": [{ "physicalLocation": {
          "artifactLocation": { "uri": "SampleApp/Validation/EmailRule.cs" },
          "region": { "startLine": 11, "snippet": { "text": "new Regex(@\"^([a-z]+)+@\")" } } } }] }
    ]
  }]
}
