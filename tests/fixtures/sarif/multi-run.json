{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": { "driver": { "name": "semgrep", "semanticVersion": "1.90.0", "rules": [
        { "id": "moraa-dotnet-disable-cert-validation",
          "shortDescription": { "text": "TLS certificate validation disabled process-wide" },
          "defaultConfiguration": { "level": "error" },
          "properties": { "tags": ["security", "CWE-295"] } }
      ] } },
      "results": [
        { "ruleId": "moraa-dotnet-disable-cert-validation", "level": "error",
          "message": { "text": "TLS certificate validation is disabled process-wide." },
          "locations": [{ "physicalLocation": {
            "artifactLocation": { "uri": "SampleApp/Services/Http.cs" },
            "region": { "startLine": 42 } } }] }
      ]
    },
    {
      "tool": { "driver": { "name": "codeql", "semanticVersion": "2.17.0", "rules": [
        { "id": "cs/sql-injection", "shortDescription": { "text": "SQL injection" },
          "defaultConfiguration": { "level": "error" } }
      ] } },
      "results": [
        { "ruleId": "cs/sql-injection", "level": "error",
          "message": { "text": "User input flows into a SQL query." },
          "locations": [{ "physicalLocation": {
            "artifactLocation": { "uri": "SampleApp/Repos/OrderRepo.cs" },
            "region": { "startLine": 88 } } }] },
        { "ruleId": "cs/sql-injection", "level": "error",
          "message": { "text": "Second injection site in the same run." },
          "locations": [{ "physicalLocation": {
            "artifactLocation": { "uri": "SampleApp/Repos/UserRepo.cs" },
            "region": { "startLine": 12 } } }] }
      ]
    }
  ]
}
