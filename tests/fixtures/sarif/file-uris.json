{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [{
    "tool": { "driver": { "name": "toolx", "rules": [
      { "id": "R-URI-1" },
      { "id": "R-URI-2" },
      { "id": "R-URI-3" }
    ] } },
    "results": [
      { "ruleId": "R-URI-1", "level": "error",
        "message": { "text": "file scheme URI on a Windows drive." },
        "locations": [{ "physicalLocation": {
          "artifactLocation": { "uri": "file:///C:/x/Web.config" },
          "region": { "startLine": 1 } } }] },
      { "ruleId": "R-URI-2", "level": "error",
        "message": { "text": "percent-encoded space in the path." },
        "locations": [{ "physicalLocation": {
          "artifactLocation": { "uri": "My%20Project/Code%20Behind.aspx.cs" },
          "region": { "startLine": 2 } } }] },
      { "ruleId": "R-URI-3", "level": "error",
        "message": { "text": "backslash separators must be normalised." },
        "locations": [{ "physicalLocation": {
          "artifactLocation": { "uri": "SampleApp\\Services\\Http.cs" },
          "region": { "startLine": 3 } } }] }
    ]
  }]
}
